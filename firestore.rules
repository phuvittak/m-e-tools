rules_version = '2';
// ---------------------------------------------------------------------------
// M.E.Tools — Firestore security rules (PRODUCTION baseline)
// วางกฎนี้ใน Firebase Console → Firestore Database → Rules → Publish
//
// ต้องเปิด Anonymous Authentication ด้วย:
//   Build → Authentication → Sign-in method → Anonymous → Enable
// เว็บจะลงชื่อเข้าใช้แบบ anonymous อัตโนมัติ เพื่อให้ request.auth ไม่ว่าง
// (กันสแปมจากผู้ที่ไม่ได้ผ่านหน้าเว็บ) แชทลูกค้า–ร้านจึงอ่าน/เขียนได้เฉพาะผู้ที่
// เข้าผ่านเว็บเท่านั้น
// ---------------------------------------------------------------------------
service cloud.firestore {
  match /databases/{database}/documents {

    // helper: ตรวจว่า uid ของผู้เรียกเป็นแอดมิน
    // แอดมินคือ doc ที่อยู่ใน /admins/{uid} — ตั้งครั้งแรกผ่าน Firebase Console:
    //   เปิด /admin/bot-inbox.html ครั้งแรก จะ sign-in anonymous → ดู uid ใน DevTools (state.fs)
    //   หรือดูใน Firebase Console → Authentication → Users
    //   แล้วสร้าง doc admins/{uid} (ค่าใดก็ได้ เช่น { addedAt: now })
    function isAdmin() {
      return request.auth != null
          && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    // รายการแอดมิน
    // - get (อ่านที่ละ doc): public — แต่ uid เป็น random ขุดหายาก + API ใช้ check
    //   isAdmin จาก server-side (ไม่งั้น chicken-and-egg: API ที่ไม่มี auth จะ check
    //   admins/{uid} ไม่ได้ → ทุก API call fail แม้ user เป็น admin จริง)
    // - list (ดู collection): เฉพาะ admin — กันไม่ให้คนเอา uids ไปทั้งหมด
    // - create: เปิดให้ user เพิ่มตัวเองได้ (uid == auth.uid) — bootstrap ผ่านปุ่มใน bot-inbox
    //   ⚠️ tradeoff: ใครก็ขึ้นเป็น admin ได้ ตราบใดที่เข้าเว็บได้
    //   หลัง bootstrap แล้ว แนะนำให้แก้ allow create เป็น `if isAdmin()` แทน
    // - update/delete: เฉพาะ admin
    match /admins/{uid} {
      allow get: if true;
      allow list: if isAdmin();
      allow create: if request.auth != null && request.auth.uid == uid;
      allow update, delete: if isAdmin();
    }

    // แชทลูกค้า: เอกสารบทสนทนา + ข้อความ
    match /chats/{convId} {
      allow read, write: if request.auth != null;
      match /messages/{messageId} {
        allow read, write: if request.auth != null;
      }
    }

    // แคตตาล็อกสินค้า (แชร์กับบอท LINE)
    // อ่าน: เปิดสาธารณะ — บอท LINE เรียกผ่าน REST API โดยไม่ต้อง auth
    // เขียน: ต้องเป็นผู้ใช้ที่ผ่านเว็บ (anonymous auth) — แอดมินซิงค์จากหน้าหลังร้าน
    match /products/{productId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // log บทสนทนาลูกค้า ↔ บอท ↔ แอดมิน (ดูในหลังร้าน "แชทบอท")
    // create: บอท Vercel เขียนแบบ paired (text + reply) ไม่มี auth
    //          แอดมินตอบจากหน้า bot-inbox เขียนแบบ flat (text + role:"admin") มี auth
    //          เว็บลูกค้าเขียนแบบ flat (text + role:"user") มี auth (Phase A4-A5)
    // read:   แอดมินอ่านได้ทั้งหมด, ลูกค้าฝั่งเว็บเห็นเฉพาะของ uid ตัวเอง
    // update/delete: ห้าม
    match /bot_messages/{msgId} {
      allow read: if isAdmin()
                || (request.auth != null && resource.data.userId == request.auth.uid);
      allow create: if request.resource.data.userId is string
                 && request.resource.data.userId.size() > 0
                 && request.resource.data.userId.size() < 100
                 && request.resource.data.text is string
                 && request.resource.data.text.size() < 5000
                 && (
                      // paired format จาก LINE webhook
                      (request.resource.data.reply is string
                        && request.resource.data.reply.size() < 5000)
                      // flat format จากแอดมิน/เว็บ
                      || (request.resource.data.role in ["user", "admin", "bot"])
                    );
      allow update: if false;
      allow delete: if isAdmin(); // ลบข้อความเก่าเกิน 7 วันจากหน้า "แชทบอท LINE"
    }

    // BigSeller webhook ขาเข้า — เก็บเหตุการณ์ออเดอร์/ยกเลิก/คืน/พัสดุ ไว้ให้หลังร้านดึงไป apply
    //   อ่าน/อัปเดต(ติด processed): แอดมินเท่านั้น
    //   create: shape-gated (มาจาก /api/bigseller-webhook ที่ตรวจลายเซ็น HMAC แล้ว — ชั้นนี้กันรูปแบบ)
    match /bigseller_events/{eventId} {
      allow read, list: if isAdmin();
      allow create: if request.resource.data.type is string
                 && request.resource.data.type.size() < 40
                 && request.resource.data.processed == false;
      allow update: if isAdmin();   // ติดธง processed หลัง apply เสร็จ
      allow delete: if isAdmin();
    }

    // AI เรียนรู้เอง — คำถามที่บอทตอบไม่ได้ (LINE webhook upsert + นับยอด)
    //   อ่าน/ลบ: แอดมิน · เขียน: shape-gated (text) หรือแอดมิน (ติดธง processed)
    match /unanswered_questions/{qId} {
      allow read, list, delete: if isAdmin();
      allow create, update: if (request.resource.data.text is string && request.resource.data.text.size() < 600)
                          || isAdmin();
    }

    // โปรไฟล์ลูกค้า (ชื่อเล่นที่แอดมินตั้ง) — แยกจาก ID ใน bot_messages
    // อ่าน: แอดมินอ่านทั้งหมด, ลูกค้าอ่านของตัวเอง
    // เขียน: แอดมินเท่านั้น (ตั้งชื่อเล่นเป็นเรื่องหลังร้าน)
    match /customer_profiles/{userId} {
      allow read: if isAdmin()
                || (request.auth != null && request.auth.uid == userId);
      allow write: if isAdmin();
    }

    // ตั้งค่าคำตอบของบอท (Phase B) — เจ้าของแก้จากหน้า bot-replies.html
    // อ่าน: เปิดสาธารณะ — line-webhook อ่านโดยไม่มี auth (เหมือน products/catalog)
    // เขียน: เฉพาะแอดมิน
    match /bot_config/{cfgId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // admin_data: คีย์ที่ admin แก้ในหลังร้านแล้วซิงค์ขึ้น cloud
    // (settings, staff, shipping rates, ledger, suppliers, purchases)

    // settings + ship_rates: ลูกค้าหน้าร้านต้องอ่านได้ (ที่อยู่ร้าน, เวลา, ค่าจัดส่ง ฯลฯ)
    // — admin เป็นคนเขียนเท่านั้น, deletePin ถูกตัดก่อน push (ดูใน store.js)
    match /admin_data/me_settings {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /admin_data/me_ship_rates {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ที่เหลือ (staff/ledger/suppliers/purchases) — เฉพาะ admin
    match /admin_data/{key} {
      allow read, write: if isAdmin();
    }

    // โปรไฟล์ลูกค้า (Phase D) — ผูกกับ Firebase Auth UID
    // อ่าน/เขียน: เฉพาะเจ้าของ uid ตัวเองเท่านั้น
    match /users/{userId} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow write: if request.auth != null && request.auth.uid == userId;
    }

    // session ของ LINE bot — เก็บโหมด (ai/human) ของลูกค้าแต่ละคน
    // เขียน: เปิดกว้าง — LINE webhook + /api/admin-reply เขียนผ่าน REST ไม่มี auth
    //         (security debt: ควรใช้ Firebase Admin SDK + service account ใน webhook/API)
    // อ่าน: แอดมิน + ลูกค้าฝั่งเว็บอ่านของ uid ตัวเอง (เผื่อในอนาคต)
    match /bot_sessions/{userId} {
      allow read: if isAdmin()
                || (request.auth != null && request.auth.uid == userId);
      allow write: if true;
    }

    // คำสั่งซื้อ (Phase E) — ลูกค้าสร้าง, แอดมินอ่าน/อัปเดตสถานะ
    // อ่าน: แอดมินอ่านทั้งหมด, ลูกค้าอ่านของตัวเอง
    // สร้าง: ต้องเป็นเจ้าของ userId
    // อัปเดต: แอดมินเท่านั้น (ลูกค้ายกเลิกผ่าน setOrderStatus ก็ผ่าน admin path)
    // ลบ: ห้าม
    match /orders/{orderId} {
      allow read: if isAdmin()
                || (request.auth != null && resource.data.userId == request.auth.uid);
      allow create: if request.auth != null
                 && request.resource.data.userId == request.auth.uid;
      allow update: if isAdmin()
                 || (request.auth != null && resource.data.userId == request.auth.uid);
      // ลบ: เฉพาะแอดมิน (เจ้าของลบออเดอร์ทดสอบ/ที่ผิดได้จากหลังร้าน — มี PIN กันพลาด)
      allow delete: if isAdmin();
    }

    // ลงทะเบียนประกันสินค้า (ลูกค้า/พนักงานกรอกฟอร์มหน้าร้าน)
    // get: เปิดสาธารณะ — ลูกค้าตรวจสอบสถานะด้วย "เลขอ้างอิง" (เลขสุ่มยาว เดาไม่ได้)
    // list/update/delete: เฉพาะแอดมิน (หน้าหลังร้าน) · create: ผู้ที่ผ่านเว็บ + มีชื่อ/เบอร์
    match /warranties/{id} {
      allow get: if true;
      allow list, update, delete: if isAdmin();
      allow create: if request.auth != null
                 && request.resource.data.firstName is string
                 && request.resource.data.phone is string;
    }

    // ขอใบเสนอราคา (B2B/ซื้อจำนวนมาก) — ลูกค้าส่งคำขอ, แอดมินดู/อัปเดตสถานะ
    match /quotes/{id} {
      allow get: if true;
      allow list, update, delete: if isAdmin();
      allow create: if request.auth != null
                 && request.resource.data.contactName is string
                 && request.resource.data.phone is string;
    }

    // กันสลิปซ้ำ — เก็บแค่ "เลขอ้างอิงรายการโอน" (transRef) ไม่มีข้อมูลส่วนตัว
    // create/get: เปิด (API ตรวจสลิปเขียน/อ่านโดยไม่ auth) · ห้าม list/แก้/ลบ (กันดึงทั้งหมด)
    match /slip_refs/{ref} {
      allow get, create: if true;
      allow list, update, delete: if false;
    }

    // อื่น ๆ ปิดทั้งหมด
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
