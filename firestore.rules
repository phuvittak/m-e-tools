rules_version = '2';
// ---------------------------------------------------------------------------
// M.E.Tools — Firestore security rules (PRODUCTION baseline)
// วางกฎนี้ใน Firebase Console → Firestore Database → Rules → Publish
//
// ต้องเปิด Anonymous Authentication ด้วย:
//   Build → Authentication → Sign-in method → Anonymous → Enable
// เว็บจะลงชื่อเข้าใช้แบบ anonymous อัตโนมัติ เพื่อให้ request.auth ไม่ว่าง
// (กันสแปมจากผู้ที่ไม่ได้ผ่านหน้าเว็บ) แชทลูกค้า–ร้านจึงอ่าน/เขียนได้เฉพาะผู้ที่
// เข้าผ่านเว็บเท่านั้น
// ---------------------------------------------------------------------------
service cloud.firestore {
  match /databases/{database}/documents {

    // helper: ตรวจว่า uid ของผู้เรียกเป็นแอดมิน
    // แอดมินคือ doc ที่อยู่ใน /admins/{uid} — ตั้งครั้งแรกผ่าน Firebase Console:
    //   เปิด /admin/bot-inbox.html ครั้งแรก จะ sign-in anonymous → ดู uid ใน DevTools (state.fs)
    //   หรือดูใน Firebase Console → Authentication → Users
    //   แล้วสร้าง doc admins/{uid} (ค่าใดก็ได้ เช่น { addedAt: now })
    function isAdmin() {
      return request.auth != null
          && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    // รายการแอดมิน
    // - อ่าน: เฉพาะ admin ด้วยกัน
    // - สร้าง: เปิดให้ user เพิ่มตัวเองได้ (uid == auth.uid) — bootstrap ผ่านปุ่มใน bot-inbox
    //   ⚠️ security tradeoff: ใครก็ขึ้นเป็น admin ได้ ตราบใดที่เข้าเว็บได้
    //   หลัง bootstrap แล้ว แนะนำให้แก้บรรทัด allow create เป็น `if isAdmin()` แทน
    // - อัปเดต/ลบ: เฉพาะ admin
    match /admins/{uid} {
      allow read: if isAdmin();
      allow create: if request.auth != null && request.auth.uid == uid;
      allow update, delete: if isAdmin();
    }

    // แชทลูกค้า: เอกสารบทสนทนา + ข้อความ
    match /chats/{convId} {
      allow read, write: if request.auth != null;
      match /messages/{messageId} {
        allow read, write: if request.auth != null;
      }
    }

    // แคตตาล็อกสินค้า (แชร์กับบอท LINE)
    // อ่าน: เปิดสาธารณะ — บอท LINE เรียกผ่าน REST API โดยไม่ต้อง auth
    // เขียน: ต้องเป็นผู้ใช้ที่ผ่านเว็บ (anonymous auth) — แอดมินซิงค์จากหน้าหลังร้าน
    match /products/{productId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // log บทสนทนาลูกค้า ↔ บอท ↔ แอดมิน (ดูในหลังร้าน "แชทบอท")
    // create: บอท Vercel เขียนแบบ paired (text + reply) ไม่มี auth
    //          แอดมินตอบจากหน้า bot-inbox เขียนแบบ flat (text + role:"admin") มี auth
    //          เว็บลูกค้าเขียนแบบ flat (text + role:"user") มี auth (Phase A4-A5)
    // read:   แอดมินอ่านได้ทั้งหมด, ลูกค้าฝั่งเว็บเห็นเฉพาะของ uid ตัวเอง
    // update/delete: ห้าม
    match /bot_messages/{msgId} {
      allow read: if isAdmin()
                || (request.auth != null && resource.data.userId == request.auth.uid);
      allow create: if request.resource.data.userId is string
                 && request.resource.data.userId.size() > 0
                 && request.resource.data.userId.size() < 100
                 && request.resource.data.text is string
                 && request.resource.data.text.size() < 5000
                 && (
                      // paired format จาก LINE webhook
                      (request.resource.data.reply is string
                        && request.resource.data.reply.size() < 5000)
                      // flat format จากแอดมิน/เว็บ
                      || (request.resource.data.role in ["user", "admin", "bot"])
                    );
      allow update, delete: if false;
    }

    // โปรไฟล์ลูกค้า (ชื่อเล่นที่แอดมินตั้ง) — แยกจาก ID ใน bot_messages
    // อ่าน: แอดมินอ่านทั้งหมด, ลูกค้าอ่านของตัวเอง
    // เขียน: แอดมินเท่านั้น (ตั้งชื่อเล่นเป็นเรื่องหลังร้าน)
    match /customer_profiles/{userId} {
      allow read: if isAdmin()
                || (request.auth != null && request.auth.uid == userId);
      allow write: if isAdmin();
    }

    // ตั้งค่าคำตอบของบอท (Phase B) — เจ้าของแก้จากหน้า bot-replies.html
    // อ่าน: เปิดสาธารณะ — line-webhook อ่านโดยไม่มี auth (เหมือน products/catalog)
    // เขียน: เฉพาะแอดมิน
    match /bot_config/{cfgId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // โปรไฟล์ลูกค้า (Phase D) — ผูกกับ Firebase Auth UID
    // อ่าน/เขียน: เฉพาะเจ้าของ uid ตัวเองเท่านั้น
    match /users/{userId} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow write: if request.auth != null && request.auth.uid == userId;
    }

    // session ของ LINE bot — เก็บโหมด (ai/human) ของลูกค้าแต่ละคน
    // เขียน: เปิดกว้าง — LINE webhook + /api/admin-reply เขียนผ่าน REST ไม่มี auth
    //         (security debt: ควรใช้ Firebase Admin SDK + service account ใน webhook/API)
    // อ่าน: แอดมิน + ลูกค้าฝั่งเว็บอ่านของ uid ตัวเอง (เผื่อในอนาคต)
    match /bot_sessions/{userId} {
      allow read: if isAdmin()
                || (request.auth != null && request.auth.uid == userId);
      allow write: if true;
    }

    // คำสั่งซื้อ (Phase E) — ลูกค้าสร้าง, แอดมินอ่าน/อัปเดตสถานะ
    // อ่าน: แอดมินอ่านทั้งหมด, ลูกค้าอ่านของตัวเอง
    // สร้าง: ต้องเป็นเจ้าของ userId
    // อัปเดต: แอดมินเท่านั้น (ลูกค้ายกเลิกผ่าน setOrderStatus ก็ผ่าน admin path)
    // ลบ: ห้าม
    match /orders/{orderId} {
      allow read: if isAdmin()
                || (request.auth != null && resource.data.userId == request.auth.uid);
      allow create: if request.auth != null
                 && request.resource.data.userId == request.auth.uid;
      allow update: if isAdmin()
                 || (request.auth != null && resource.data.userId == request.auth.uid);
      allow delete: if false;
    }

    // อื่น ๆ ปิดทั้งหมด
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
